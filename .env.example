# Docker/Nginx Proxy Manager deployment on the SOL12 VPS.
PORT=8091
TOR_NETWORK_NAME=tor-docker_default
NPM_NETWORK_NAME=nginx-proxy-manager_default

# The sidecar shares Tor's network namespace; connect to port 9052.
SOL12NET_CONTROL_HOST=tor-relay
SOL12NET_CONTROL_PORT=9052
SOL12NET_COOKIE_PATH=/run/tor/sol12net/control_auth_cookie
TOR_COOKIE_HOST_PATH=/var/lib/docker/volumes/tor-docker_tor-data/_data/control_auth_cookie
# Match the actual group owner of the cookie (stat -c '%g' on the VPS).
TOR_COOKIE_GID=101
